@code {
    private enum MenuViewType { Hub, Categories, Dishes }

    private MenuViewType currentView = MenuViewType.Hub;
    private string currentSectionTitle = "Meniu";
    private CategoryType? selectedType;

    private UserDto? currentUser;
    private bool isLoading = true;

    private List<CategoryDto> allCategories = new();
    private List<CategoryDto> displayedCategories = new();

    private List<DishDto> allDishes = new();
    private List<DishDto> displayedDishes = new();

    private List<AllergenDto> allAllergens = new();
    private HashSet<int> selectedAllergenIds = new();

    private string searchText = string.Empty;
    private bool showAllergensPanel = false;

    private DishDto? selectedDish;
    private int orderQuantity = 1;
    private bool showCartModal = false;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += StateHasChanged;
        currentUser = await AuthClient.GetCurrentUserAsync();

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            allCategories = await MenuClient.GetCategoriesAsync();
            allAllergens = await MenuClient.GetAllergensAsync();
            allDishes = await MenuClient.GetDishesAsync();
            displayedDishes = allDishes;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", $"Failed loading menu data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToSubcategories(CategoryType type, string title)
    {
        selectedType = type;
        currentSectionTitle = title;
        displayedCategories = allCategories.Where(c => c.Type == type).ToList();
        currentView = MenuViewType.Categories;
    }

    private async Task NavigateToPopularDishes()
    {
        isLoading = true;
        currentSectionTitle = "Cele mai populare";
        displayedDishes = await MenuClient.GetPopularDishesAsync(6);
        currentView = MenuViewType.Dishes;
        isLoading = false;
    }

    private async Task NavigateToDishesByCategory(CategoryDto category)
    {
        isLoading = true;
        currentSectionTitle = category.Name;
        displayedDishes = await MenuClient.GetDishesAsync(categoryId: category.Id);
        currentView = MenuViewType.Dishes;
        isLoading = false;
    }

    private void HandleBackClick()
    {
        if (currentView == MenuViewType.Dishes && selectedType.HasValue)
        {
            currentView = MenuViewType.Categories;
        }
        else
        {
            currentView = MenuViewType.Hub;
            selectedType = null;
            currentSectionTitle = "Meniu";
        }
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        displayedDishes = await MenuClient.GetDishesAsync(
            search: searchText,
            excludedAllergenIds: selectedAllergenIds.ToList()
        );
        isLoading = false;
    }

    private async Task ToggleAllergen(int allergenId)
    {
        if (selectedAllergenIds.Contains(allergenId))
        {
            selectedAllergenIds.Remove(allergenId);
        }
        else
        {
            selectedAllergenIds.Add(allergenId);
        }
        await ApplyFilters();
    }

    private async Task ClearFilters()
    {
        searchText = string.Empty;
        selectedAllergenIds.Clear();
        showAllergensPanel = false;
        await ApplyFilters();
    }

    private void OpenDishDetails(DishDto dish)
    {
        selectedDish = dish;
        orderQuantity = 1;
    }

    private void CloseDishDetails()
    {
        selectedDish = null;
        orderQuantity = 1;
    }

    private void AddToCart()
    {
        if (selectedDish != null)
        {
            Cart.AddToCart(selectedDish, orderQuantity);
            CloseDishDetails();
        }
    }

    private async Task HandleCheckout()
    {
        await JS.InvokeVoidAsync("alert", $"Plasarea comenzii va fi finalizata in pasul urmator! Total: {Cart.TotalPrice:0.00} lei");
    }

    private async Task HandleAddressClick()
    {
        await JS.InvokeVoidAsync("alert", "Selectia adresei de livrare va fi disponibila la finalizarea comenzii.");
    }

    private async Task HandleStatusClick()
    {
        await JS.InvokeVoidAsync("alert", "Nu exista comenzi in desfasurare.");
    }

    private async Task HandleLogout()
    {
        await AuthClient.LogoutAsync();
        currentUser = null;
        Navigation.NavigateTo("/", forceLoad: false);
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
    }
}
