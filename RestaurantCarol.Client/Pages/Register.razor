@page "/register"
@inject IAuthHttpClient AuthClient
@inject NavigationManager Navigation

<PageTitle>Register - Restaurant Carol</PageTitle>

<div class="restaurant-background-page">
    <header class="restaurant-header">
        <img src="images/carol_logo.png" alt="Carol Logo Left" class="restaurant-logo" />

        <div class="restaurant-header-text">
            <h1>Restaurant Carol</h1>
            <p>European Cuisine Restaurant</p>
        </div>

        <img src="images/carol_logo.png" alt="Carol Logo Right" class="restaurant-logo" />
    </header>

    <div class="carol-card">
        <h2>Create Account</h2>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="carol-alert-danger">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="carol-alert-success">
                @successMessage
            </div>
        }

        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <div class="carol-form-group">
                <label class="carol-form-label">First Name:</label>
                <InputText class="carol-input" @bind-Value="registerModel.FirstName" placeholder="Enter first name" />
                <ValidationMessage For="@(() => registerModel.FirstName)" class="text-danger small mt-1" />
            </div>

            <div class="carol-form-group">
                <label class="carol-form-label">Last Name:</label>
                <InputText class="carol-input" @bind-Value="registerModel.LastName" placeholder="Enter last name" />
                <ValidationMessage For="@(() => registerModel.LastName)" class="text-danger small mt-1" />
            </div>

            <div class="carol-form-group">
                <label class="carol-form-label">Email:</label>
                <InputText class="carol-input" @bind-Value="registerModel.Email" placeholder="Enter email" />
                <ValidationMessage For="@(() => registerModel.Email)" class="text-danger small mt-1" />
            </div>

            <div class="carol-form-group">
                <label class="carol-form-label">Phone Number (optional):</label>
                <InputText class="carol-input" @bind-Value="registerModel.PhoneNumber" placeholder="Enter phone number" />
                <ValidationMessage For="@(() => registerModel.PhoneNumber)" class="text-danger small mt-1" />
            </div>

            <div class="carol-form-group">
                <label class="carol-form-label">Password:</label>
                <InputText type="password" class="carol-input" @bind-Value="registerModel.Password" placeholder="Min 6 characters" />
                <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small mt-1" />
            </div>

            <div class="d-flex flex-column align-items-center mt-3">
                <button type="submit" class="btn-carol-gold" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span>Creating account...</span>
                    }
                    else
                    {
                        <span>Register</span>
                    }
                </button>

                <button type="button" class="btn-carol-gold" @onclick='() => Navigation.NavigateTo("/")'>
                    Back
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await AuthClient.RegisterAsync(registerModel);

            if (response.Success)
            {
                successMessage = "Account created successfully! Redirecting...";
                await Task.Delay(1500);
                Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = response.Message ?? "Failed to create account.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
